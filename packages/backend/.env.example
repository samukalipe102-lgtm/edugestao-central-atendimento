# Banco de dados — SQLite local por padrão (migrável a PostgreSQL)
DATABASE_URL="file:./data/edugestao.db"

# Servidor
PORT=4000
# Chave para assinar os tokens de sessão do admin (gere uma aleatória forte)
JWT_SECRET="troque-por-uma-chave-aleatoria-longa"
# Chave para cifrar tokens OAuth em repouso (32 bytes em base64)
TOKEN_ENCRYPTION_KEY=""

# --- Gmail API (conta de ENVIO: secretariaedugestao@gmail.com) ---
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:4000/api/integrations/gmail/callback"

# --- Microsoft Graph (conta de RECEBIMENTO: admsedugestao@outlook.com) ---
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT="consumers"
MS_REDIRECT_URI="http://localhost:4000/api/integrations/outlook/callback"

# --- IA (opcional, desligada por padrão) ---
# Deixe vazio para operar sem IA (apenas organização + decisão do admin).
GEMINI_API_KEY=""
