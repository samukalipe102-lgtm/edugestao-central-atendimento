# Banco de dados — SQLite local por padrão (migrável a PostgreSQL)
DATABASE_URL="file:./data/edugestao.db"

# Servidor
PORT=4000
# Chave para assinar os tokens de sessão do admin (gere uma aleatória forte)
JWT_SECRET="troque-por-uma-chave-aleatoria-longa"
# Chave para cifrar tokens OAuth em repouso (32 bytes em base64)
TOKEN_ENCRYPTION_KEY=""

# --- Gmail API (duas contas, UM único app OAuth no Google Cloud) ---
# ENVIO:       secretariaedugestao@gmail.com
# RECEBIMENTO: admsedugestao@gmail.com
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_SEND_REDIRECT_URI="http://localhost:4000/api/integrations/gmail-send/callback"
GMAIL_RECV_REDIRECT_URI="http://localhost:4000/api/integrations/gmail-recv/callback"

# --- IA (opcional, desligada por padrão) ---
# Deixe vazio para operar sem IA (apenas organização + decisão do admin).
GEMINI_API_KEY=""
